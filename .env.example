# Copy to .env (gitignored) and fill in. The build script auto-loads .env.
#
# Census API (free, instant): https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# api.data.gov / api.usa.gov (free): https://api.data.gov/signup/
# Used by NPS, FBI CDE, and other federal API gateways.
USA_GOV_API_KEY=

# EIA (free, instant): https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# BEA (free, instant): https://apps.bea.gov/API/signup/
BEA_API_KEY=

# NOAA Climate Data Online (free): https://www.ncdc.noaa.gov/cdo-web/token
NOAA_CDO_TOKEN=

# OpenWeatherMap (free): https://openweathermap.org/api
OPENWEATHER_API_KEY=
